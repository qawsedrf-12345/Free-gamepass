local aura = {
    ativa = CONFIG.Aura.Ativa, nivel = CONFIG.Aura.Intensidade,
    char = nil, orbitas = {}, hl = nil, att = nil, conn = nil, loop = nil,
    tGhost = 0, tCrack = 0, token = 0,
}

local function auraParar()
    aura.token = aura.token + 1
    if aura.conn then aura.conn:Disconnect(); aura.conn = nil end
    for _, o in ipairs(aura.orbitas) do pcall(function() o.parte:Destroy() end) end
    aura.orbitas = {}
    if aura.hl then pcall(function() aura.hl:Destroy() end); aura.hl = nil end
    if aura.att then pcall(function() aura.att:Destroy() end); aura.att = nil end
    if aura.loop then pararLoop(aura.loop); aura.loop = nil end
    aura.char = nil
end

-- "imagem residual": cópias neon dos membros, deslocadas, que somem
local function auraGhost(char)
    local partes = {}
    for _, d in ipairs(char:GetChildren()) do
        if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.95 then
            partes[#partes + 1] = d
        end
    end
    if #partes == 0 then return end
    local n = math.min(#partes, math.random(2, 4))
    local off = Vector3.new(rf(-2.2, 2.2), rf(-0.6, 0.6), rf(-2.2, 2.2))
    local cor = pick({ PALETA.Ciano, PALETA.Magenta, PALETA.Vermelho })
    for _ = 1, n do
        local p = pick(partes)
        local g = novaParte({ Size = p.Size, CFrame = p.CFrame + off, Color = cor, Transparency = 0.45 })
        local dur = rf(0.22, 0.45)
        tw(g, dur, { Transparency = 1, CFrame = p.CFrame + off * 1.7 })
        task.delay(dur + 0.1, function() g:Destroy() end)
    end
end

local function auraPasso(dt)
    local char = aura.char
    local rp = char and char:FindFirstChild("HumanoidRootPart")
    if not rp or not rp.Parent then auraParar(); return end
    local t = os.clock()
    local centro = rp.Position
    local nivel = aura.nivel

    for _, o in ipairs(aura.orbitas) do
        o.ang = o.ang + o.vel * dt
        local r = o.raio * (1 + 0.15 * math.sin(t * 3 + o.fase))
        local y = o.alt + math.sin(t * 2 + o.fase) * 0.6
        local pos = centro + Vector3.new(math.cos(o.ang) * r, y, math.sin(o.ang) * r)
        if math.random() < 0.012 * nivel then
            pos = pos + Vector3.new(rf(-2, 2), rf(-1.5, 1.5), rf(-2, 2))
        end
        o.parte.CFrame = CFrame.new(pos) * CFrame.Angles(o.ang * 2, o.ang, 0)
        if math.random() < 0.03 then o.parte.Color = pick(NEONS) end
        if math.random() < 0.02 then o.parte.Transparency = rf(0.1, 0.8) end
    end

    if aura.hl and math.random() < 0.15 then
        aura.hl.OutlineColor = pick({ PALETA.Ciano, PALETA.Magenta, PALETA.Vermelho, PALETA.Branco })
        aura.hl.OutlineTransparency = rf(0, 0.6)
        aura.hl.Enabled = math.random() > 0.08
    end

    aura.tGhost = aura.tGhost - dt
    if aura.tGhost <= 0 then
        aura.tGhost = rf(0.25, 0.7) / nivel
        if Q >= 0.5 or math.random() < 0.5 then auraGhost(char) end
    end

    aura.tCrack = aura.tCrack - dt
    if aura.tCrack <= 0 then
        aura.tCrack = rf(1.2, 3.2) / math.sqrt(nivel)
        if CONFIG.Aura.Som then sfx.auraCrackle() end
        if CONFIG.Aura.TelaGlitch and not emMorte and introEstado ~= "rodando" and not tpOcupado then
            aberracao(0.18, 6, 0.7)
        end
    end
end

local function auraIniciar(character)
    auraParar()
    if not aura.ativa or encerrado or not character then return end
    local rp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not rp or not hum or hum.Health <= 0 then return end

    aura.char = character
    local meu = aura.token
    local nivel = aura.nivel

    aura.hl = novo("Highlight", {
        Adornee = character, FillTransparency = 1, OutlineColor = PALETA.Ciano, OutlineTransparency = 0.15,
        DepthMode = Enum.HighlightDepthMode.Occluded,
    }, fxFolder)

    aura.att = Instance.new("Attachment")
    aura.att.Parent = rp
    novo("ParticleEmitter", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, PALETA.Ciano),
            ColorSequenceKeypoint.new(0.5, PALETA.Magenta),
            ColorSequenceKeypoint.new(1, PALETA.Roxo),
        }),
        LightEmission = 1, Rate = math.max(4, math.floor(14 * nivel * Q)),
        Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) }),
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
        Lifetime = NumberRange.new(0.5, 1.2), Speed = NumberRange.new(1, 5),
        SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, 4, 0),
        Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-200, 200),
    }, aura.att)

    for i = 1, N(4 + 4 * nivel) do
        local t = rf(0.2, 0.5)
        aura.orbitas[i] = {
            parte = novaParte({ Size = Vector3.new(t, t, t), Color = pick(NEONS), Transparency = 0.15 }),
            ang = math.random() * math.pi * 2,
            vel = rf(0.8, 2.2) * ((math.random() < 0.5) and 1 or -1),
            raio = rf(2.4, 4.2), alt = rf(-2.2, 2.6), fase = math.random() * 6.28,
        }
    end

    aura.tGhost, aura.tCrack = 0.3, 0.8
    aura.conn = RunService.Heartbeat:Connect(auraPasso)

    if CONFIG.Aura.Som then
        task.spawn(function()
            local s = tocarLoop(SONS.bass, 0.16, 0.35, {
                { "TremoloSoundEffect", { Depth = 0.6, Frequency = 4, Duty = 0.5 } },
                { "DistortionSoundEffect", { Level = 0.3 } },
            })
            if s then
                if aura.token == meu and aura.char == character then aura.loop = s else pararLoop(s) end
            end
        end)
    end
end

