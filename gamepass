-- ---- busca de nick (Original = Name | Visual = DisplayName) ----
local function buscarAlvos(txt)
    local q = txt:lower()
    local lista = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local n, d = p.Name, p.DisplayName
            local nl, dl = n:lower(), d:lower()
            local melhor = nil
            if nl:sub(1, #q) == q then
                melhor = { player = p, texto = n, campo = "ORIGINAL", prefixo = true }
            end
            if dl:sub(1, #q) == q then
                if not melhor or #d < #n then
                    melhor = { player = p, texto = d, campo = "VISUAL", prefixo = true }
                end
            end
            if not melhor then
                local achouN = nl:find(q, 1, true)
                local achouD = dl:find(q, 1, true)
                if achouN or achouD then
                    melhor = { player = p, texto = achouN and n or d, campo = achouN and "ORIGINAL" or "VISUAL", prefixo = false }
                end
            end
            if melhor then lista[#lista + 1] = melhor end
        end
    end
    table.sort(lista, function(a, b)
        if a.prefixo ~= b.prefixo then return a.prefixo end
        if #a.texto ~= #b.texto then return #a.texto < #b.texto end
        return a.texto:lower() < b.texto:lower()
    end)
    return lista
end

local function mostrarCartao(p, msg, info)
    if not MN.cartaoStatus then return end
    if not p then
        local semMatch = (msg == "NO MATCH FOUND")
        MN.cartaoStatus.Text = msg or ""
        MN.cartaoStatus.TextColor3 = Color3.fromRGB(140, 150, 180)
        MN.cartaoOriginal.Text, MN.cartaoVisual.Text = "-", "-"
        MN.cartaoOriginal.TextColor3, MN.cartaoVisual.TextColor3 = PALETA.Branco, PALETA.Branco
        MN.statusPonto.Text = semMatch and "[ NO MATCH ]" or "[ IDLE ]"
        MN.statusPonto.TextColor3 = semMatch and PALETA.Vermelho or Color3.fromRGB(140, 150, 180)
        return
    end
    local exato = info and (info.texto:lower() == trim(MN.caixa.Text):lower())
    local dist = ""
    local meuChar = player.Character
    local meuRoot = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
    local aRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if meuRoot and aRoot then
        dist = string.format("  //  %d STUDS", math.floor((meuRoot.Position - aRoot.Position).Magnitude))
    end
    MN.cartaoStatus.Text = (exato and "TARGET LOCKED" or "TARGET FOUND") .. dist
    MN.cartaoStatus.TextColor3 = exato and PALETA.Verde or PALETA.Amarelo
    MN.cartaoOriginal.Text = p.Name
    MN.cartaoVisual.Text = p.DisplayName
    local campo = info and info.campo
    MN.cartaoOriginal.TextColor3 = (campo == "ORIGINAL") and PALETA.Amarelo or PALETA.Branco
    MN.cartaoVisual.TextColor3 = (campo == "VISUAL") and PALETA.Amarelo or PALETA.Branco
    MN.statusPonto.Text = exato and "[ LOCKED ]" or "[ MATCH ]"
    MN.statusPonto.TextColor3 = exato and PALETA.Verde or PALETA.Amarelo
end

