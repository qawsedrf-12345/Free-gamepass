        }, gui))
        local barraBg = mk(frame({
            Position = UDim2.new(0.06, 0, 0.62, 0), Size = UDim2.new(0.5, 0, 0, 8),
            BackgroundColor3 = Color3.fromRGB(14, 18, 36), BackgroundTransparency = 0, ZIndex = 1031,
