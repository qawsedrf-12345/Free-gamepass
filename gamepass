local function estrelaFlare(cor, dur)
    local diag = diagTela()
    local miolo = frame({
        Size = UDim2.new(0, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        BackgroundColor3 = PALETA.Branco, BackgroundTransparency = 0, ZIndex = 1015,
    }, G.fx)
    novo("UICorner", { CornerRadius = UDim.new(1, 0) }, miolo)
    tw(miolo, dur * 0.35, { Size = UDim2.fromOffset(44, 44) }, Enum.EasingStyle.Back)
    task.delay(dur * 0.35, function()
        tw(miolo, dur * 0.65, { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 })
    end)
    task.delay(dur + 0.1, function() miolo:Destroy() end)

