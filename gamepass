            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1),
            }),
        }, r)
        tw(r, dur * 0.4, { Size = UDim2.new(0, compr, 0, esp) }, Enum.EasingStyle.Quart)
        task.delay(dur * 0.4, function()
            tw(r, dur * 0.6, { Size = UDim2.new(0, compr * 1.25, 0, 0), BackgroundTransparency = 1 })
        end)
        task.delay(dur + 0.1, function() r:Destroy() end)
    end
    raio(0, diag * 1.2, 4, cor)
    raio(90, diag * 0.7, 3, PALETA.Branco)
    raio(45, diag * 0.35, 2, cor)
    raio(-45, diag * 0.35, 2, cor)
end

