        }, gui))
        local hex1 = mk(texto({
            Position = UDim2.new(0.72, 0, 0.12, 0), Size = UDim2.new(0.24, 0, 0.7, 0), TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top,
