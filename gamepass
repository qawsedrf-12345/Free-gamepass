local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&@<>/\\|"
local revTokens = {}

local function revelar(labels, alvo, dur)
    local chave = labels[1]
    revTokens[chave] = (revTokens[chave] or 0) + 1
    local meu = revTokens[chave]
    task.spawn(function()
        local ini, n = os.clock(), #alvo
        while not encerrado and revTokens[chave] == meu do
            local p = (os.clock() - ini) / dur
            if p >= 1 then break end
            local fixos = math.floor(p * n)
            local partes = { alvo:sub(1, fixos) }
            for i = fixos + 1, n do
                local ch = alvo:sub(i, i)
                if ch == " " then
                    partes[#partes + 1] = " "
                else
                    local r = math.random(#CHARS)
                    partes[#partes + 1] = CHARS:sub(r, r)
                end
            end
            local s = table.concat(partes)
            for _, l in ipairs(labels) do l.Text = s end
            task.wait(0.03)
        end
        if revTokens[chave] == meu then
            for _, l in ipairs(labels) do l.Text = alvo end
        end
    end)
end

local function hexLinha(n)
    local t = {}
    for i = 1, n do
        t[i] = string.format("%04X %06X %02X", math.random(0, 65535), math.random(0, 16777215), math.random(0, 255))
    end
    return table.concat(t, "\n")
end

local function ecgValor(fase)
    if fase < 0.10 then return 0.12 * math.sin(fase / 0.10 * math.pi)
    elseif fase < 0.16 then return 0
    elseif fase < 0.19 then return -0.18
    elseif fase < 0.23 then return 1.0
    elseif fase < 0.27 then return -0.35
    elseif fase < 0.34 then return 0
    elseif fase < 0.50 then return 0.22 * math.sin((fase - 0.34) / 0.16 * math.pi)
    end
    return 0
end

local function iniciarHudMorte(ciclo)
    if not CONFIG.Hud.Ativo then return end
    if hudConn then hudConn:Disconnect(); hudConn = nil end
    local M = CONFIG.Morte
    local lista = { G.titulo, G.tituloR, G.tituloC }

    G.hud.Visible = true
    G.titStroke.Color = PALETA.Vermelho
    G.tituloR.TextColor3 = PALETA.Vermelho
    G.tituloC.TextColor3 = PALETA.Ciano
    G.barraBg.Visible = false
    G.barraFill.Size = UDim2.new(0, 0, 1, 0)
    G.barraTag.Text, G.barraPct.Text = "", ""
    G.ecg.Visible = M.ECG and true or false
    for _, p in ipairs(G.ecgPts) do p.BackgroundColor3 = PALETA.Verde end
    G.hexL.Visible, G.hexR.Visible = true, true

    if CONFIG.Hud.Textos then
        revelar(lista, "SIGNAL LOST", 0.55)
        revelar({ G.sub }, "NEURAL LINK SEVERED", 0.6)
    else
        for _, l in ipairs(lista) do l.Text = "" end
        G.sub.Text = ""
    end

    local okRT, rt = pcall(function() return Players.RespawnTime end)
    local tempoEst = math.max((okRT and tonumber(rt)) or 5, 1.5)
    local ini = os.clock()
    local ultHex, ultEcg, fase, flat = 0, 0, 0, false
    local mostrouBarra = false
    local amostras = {}
    for i = 1, ECG_N do amostras[i] = 0 end

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if encerrado or cicloAtual ~= ciclo or not emMorte then
            conn:Disconnect()
            if hudConn == conn then hudConn = nil end
            return
        end
        local t = os.clock() - ini

        G.roll.Position = UDim2.new(0, 0, ((t * 0.45) % 1.3) - 0.2, 0)

        if math.random() < 0.07 then
            G.tituloR.Position = UDim2.new(0.5, -math.random(3, 12), 0.40, math.random(-3, 3))
            G.tituloC.Position = UDim2.new(0.5, math.random(3, 12), 0.40, math.random(-3, 3))
        else
            G.tituloR.Position = UDim2.new(0.5, -4, 0.40, 0)
            G.tituloC.Position = UDim2.new(0.5, 4, 0.40, 0)
        end

        if t > 1.1 then
            if not mostrouBarra then
                mostrouBarra = true
                G.barraBg.Visible = true
                G.barraTag.Text = "CAPRI.EXE"
                if CONFIG.Hud.Textos then revelar({ G.sub }, "RECONSTRUCTING CONSTRUCT", 0.6) end
            end
            local x = (t - 1.1) / math.max(tempoEst - 1.1, 1)
            local prog = 0.97 * (1 - math.exp(-2.2 * x))
            G.barraFill.Size = UDim2.new(prog, 0, 1, 0)
            G.barraPct.Text = string.format("%d%%", math.floor(prog * 100))
        end

        if t - ultHex > 0.08 then
            ultHex = t
            G.hexL.Text = hexLinha(18)
            G.hexR.Text = hexLinha(18)
        end

        if M.ECG and t - ultEcg > 0.025 then
            ultEcg = t
            local v
            if t < 0.9 then
                fase = (fase + 0.025 / 0.55) % 1
                v = ecgValor(fase)
            else
                v = (math.random() - 0.5) * 0.02
                if not flat then
                    flat = true
                    for _, p in ipairs(G.ecgPts) do p.BackgroundColor3 = PALETA.Vermelho end
                end
            end
            table.remove(amostras, 1)
            amostras[#amostras + 1] = v
            for i = 1, ECG_N do
                G.ecgPts[i].Position = UDim2.new((i - 1) / (ECG_N - 1), 0, 0.5 - amostras[i] * 0.45, 0)
            end
        end
    end)
    hudConn = conn
end

local function hudRespawn(ciclo)
    if not CONFIG.Hud.Ativo then return end
    local lista = { G.titulo, G.tituloR, G.tituloC }

    G.hud.Visible = true
    G.ecg.Visible = false
    G.hexL.Visible, G.hexR.Visible = false, false
