        local nome = string.upper((player.DisplayName:gsub("[^%w _%-]", "")))
        if nome == "" then nome = "NETRUNNER" end
        revelar(lista, "CONSTRUCT ONLINE", 0.5)
        revelar({ G.sub }, "WELCOME BACK, " .. nome, 0.55)
    else
        for _, l in ipairs(lista) do l.Text = "" end
        G.sub.Text = ""
    end

    task.delay(1.7, function()
        if encerrado or cicloAtual ~= ciclo or emMorte then return end
        for _ = 1, 3 do
            G.hud.Visible = false; task.wait(0.04)
            G.hud.Visible = true;  task.wait(0.04)
