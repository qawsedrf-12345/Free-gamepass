        novo("UIStroke", { Color = PALETA.Ciano, Thickness = 1, Transparency = 0.3 }, barraBg)
        local barraFill = frame({ Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = PALETA.Ciano,
                                  BackgroundTransparency = 0, ZIndex = 1032 }, barraBg)
        local pct = mk(texto({
            Position = UDim2.new(0.56, 8, 0.62, -4), Size = UDim2.fromOffset(60, 16),
            TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13, TextColor3 = PALETA.Ciano, ZIndex = 1031,
        }, gui))

        local function tituloI(cor, dx, transp, z)
            return mk(texto({
                Size = UDim2.new(0.8, 0, 0.14, 0), AnchorPoint = Vector2.new(0.5, 0.5),
