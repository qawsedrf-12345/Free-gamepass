local function viewport()
    local c = workspace.CurrentCamera
    if c then return c.ViewportSize.X, c.ViewportSize.Y end
    return 1280, 720
end

local function calcEscala()
    local vw, vh = viewport()
    local s = math.min(1.25, (vw * 0.92) / BW, (vh * 0.9) / BH)
    return math.max(0.5, s), vw, vh
end

local function tamanhoMenu()
    return math.floor(BW * MN.escala + 0.5), math.floor(BH * MN.escala + 0.5)
end

local function limitarPos(cx, cy, w, h)
    local vw, vh = viewport()
    cx = math.clamp(cx, w / 2 + 2, math.max(w / 2 + 2, vw - w / 2 - 2))
    cy = math.clamp(cy, h / 2 + 2, math.max(h / 2 + 2, vh - h / 2 - 2))
    return cx, cy
end

