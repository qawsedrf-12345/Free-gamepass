local function novaParte(props)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
    p.CastShadow = false
    p.Massless = true
    p.Material = Enum.Material.Neon
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    for k, v in pairs(props) do p[k] = v end
    p.Parent = fxFolder
    return p
end

local function alturaChao(pos, ignorar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local lista = { fxFolder }
    if ignorar then lista[#lista + 1] = ignorar end
    params.FilterDescendantsInstances = lista
    local r = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -40, 0), params)
    return r and (r.Position.Y + 0.15) or (pos.Y - 3)
end

