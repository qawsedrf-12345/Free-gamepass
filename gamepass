local function sequenciaMorte(character, ciclo)
    local M = CONFIG.Morte
    emMorte = true
    local camera = workspace.CurrentCamera
    if camera and not fovOriginal then fovOriginal = camera.FieldOfView end

    audioMorte()

    if M.Flash then
        flashTela(PALETA.Branco, 0.12, 0)
        task.delay(0.06, function() flashTela(PALETA.Vermelho, 0.45, 0.35) end)
    end
    if M.Escurecer then tw(G.escuro, 0.9, { BackgroundTransparency = 0.5 }) end
    if M.Letterbox then letterbox(true, 0.45) end
    if M.ColorGrade then gradeMorte() end
    if M.Bloom then pulso(efl.bloom, "Intensity", 2.4, 0.9) end
    if M.Blur then pulso(efl.blur, "Size", 22, 1.0) end
    if M.Vinheta then vinhetaSet(PALETA.Vermelho, 0.3, 0.35) end
    if M.Aberracao then aberracao(0.6, 12) end
    if M.Scanlines then G.scan.Visible = true end
    if M.Shake then camShake(3.0, 0.65, true) end
    if M.Zoom and camera then camFov(camera.FieldOfView, (fovOriginal or 70) - 12, 2.4) end
    if M.Glitch then glitchBlocos(0.8, 16) end
    if M.Voxels > 0 then seguro(voxelDesintegrar, character) end
    if M.Particulas then
        local rp = character:FindFirstChild("HumanoidRootPart")
        if rp then particulas3D(rp, 90, { PALETA.Ciano, PALETA.Magenta, PALETA.Roxo }) end
    end
    seguro(iniciarHudMorte, ciclo)
end

local function sequenciaRespawn(character, ciclo)
    local R = CONFIG.Respawn
    local rp = character:FindFirstChild("HumanoidRootPart")
    if not rp then return end
    local pos = rp.Position
    local chao = Vector3.new(pos.X, alturaChao(pos, character), pos.Z)
    local camera = workspace.CurrentCamera

    emMorte = false
    if hudConn then hudConn:Disconnect(); hudConn = nil end
    local fov0 = fovOriginal or (camera and camera.FieldOfView) or 70

    audioRespawn()

    -- tela: decrypt + flash
    if R.GradeDecrypt then
        G.escuro.BackgroundTransparency = 1
        gradeDecrypt()
    else
        tw(G.escuro, 0.5, { BackgroundTransparency = 1 })
    end
    if R.Flash then flashTela(PALETA.Branco, 0.25, 0.05) end
    letterbox(false, 0.55)
    vinhetaSet(PALETA.Vermelho, 1, 0.5)
    if R.ColorGrade then gradeRespawn() else resetGrade(0.5) end
    if R.Bloom then pulso(efl.bloom, "Intensity", 3, 0.9) end
    if R.Blur then pulso(efl.blur, "Size", 16, 0.5) end
    if R.Aberracao then aberracao(0.7, 16, 0.55) end
    if R.Scanlines then
        G.scan.Visible = true
        task.delay(0.6, function() if not emMorte then G.scan.Visible = false end end)
    else
        G.scan.Visible = false
    end
    if R.Shake then camShake(1.6, 0.45, false) end
    if camera then
        if R.PunchFOV then
            camFov(fov0 + 40, fov0, 0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        else
            camFov(camera.FieldOfView, fov0, 0.4)
        end
    end
    task.delay(1.2, function() if not emMorte then fovOriginal = nil end end)

    if R.EstrelaFlare then estrelaFlare(PALETA.Ciano, 0.9) end
    for i = 1, R.Ondas do
        ondaDiamante((i % 2 == 0) and PALETA.Magenta or PALETA.Ciano, 0.7, 0.07 * (i - 1))
    end
    if R.Particulas then particulas2D(70, { PALETA.Ciano, PALETA.Magenta, PALETA.Amarelo, PALETA.Branco }) end

    -- mundo 3D
    if R.Voxels > 0 then seguro(voxelMaterializar, rp) end
    if R.Feixe then feixeSatelite(chao) end
    if R.DiscosChao then
        discoChao(chao, PALETA.Ciano, 16, 0.8, 0.05)
        discoChao(chao, PALETA.Magenta, 24, 0.9, 0.17)
        discoChao(chao, PALETA.Branco, 10, 0.5, 0.30)
    end
    if R.Luz then luzFlash(pos, PALETA.Ciano, 0.9) end
    if R.Highlight then seguro(highlightGlitch, character, 1.0) end
    if R.PiscarCorpo then seguro(piscarCorpo, character, 0.7) end
    if R.Particulas then particulas3D(rp, 70, { PALETA.Ciano, PALETA.Magenta, PALETA.Amarelo }) end

    seguro(hudRespawn, ciclo)
end

