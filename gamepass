local function atualizarBusca()
    if not MN.caixa then return end
    local bruto = MN.caixa.Text
    local txt = trim(bruto)
    local minL = CONFIG.TP.MinLetras

    if #txt < minL then
        MN.alvo, MN.alvoTexto, MN.ultimoAlvo = nil, "", nil
        MN.ghost.Text = ""
        mostrarCartao(nil, (#txt == 0) and "AWAITING INPUT ..." or ("TYPE " .. minL .. "+ CHARS"))
        atualizarChips({})
        return
    end

    local lista = buscarAlvos(txt)
    local melhor = lista[1]
    if not melhor then
        MN.alvo, MN.alvoTexto = nil, ""
        MN.ghost.Text = ""
        mostrarCartao(nil, "NO MATCH FOUND")
        atualizarChips({})
        MN.ultimoAlvo = nil
        return
    end

    MN.alvo, MN.alvoTexto = melhor.player, melhor.texto
    -- fantasma vermelho: espaços no lugar do que já foi digitado + o resto do nick (fonte monoespaçada)
    if melhor.prefixo and #melhor.texto > #txt then
        MN.ghost.Text = string.rep(" ", #bruto) .. melhor.texto:sub(#txt + 1)
    else
        MN.ghost.Text = ""
    end
    mostrarCartao(melhor.player, nil, melhor)
    atualizarChips(lista)
    if MN.ultimoAlvo ~= melhor.player then
        MN.ultimoAlvo = melhor.player
        if not MN.autoPreenchendo then sfx.achou() end
    end
end

-- completa o texto "digitando" o resto do nick (letras vermelhas viram brancas)
local function completarTexto(completo, depois)
    if not MN.caixa then return end
    MN.autoPreenchendo = true
    seguro(function()
        local ok = pcall(function()
            local atual = trim(MN.caixa.Text)
            local n = #completo
            if #atual < n and completo:sub(1, #atual):lower() == atual:lower() then
                MN.caixa.Text = completo:sub(1, #atual)
                for i = #atual + 1, n do
                    MN.caixa.Text = completo:sub(1, i)
                    if i % 2 == 0 then sfx.tick() end
                    task.wait(0.03)
                end
            else
                MN.caixa.Text = completo
            end
            pcall(function() MN.caixa.CursorPosition = #completo + 1 end)
        end)
        MN.autoPreenchendo = false
        if ok and depois then depois() end
    end)
end

local function confirmar()
    local txt = trim(MN.caixa.Text)
    if #txt < CONFIG.TP.MinLetras then
        sfx.erro()
        toast("TYPE A NICK (" .. CONFIG.TP.MinLetras .. "+ CHARS)", PALETA.Vermelho)
        return
    end
    atualizarBusca()
    if not MN.alvo then
        sfx.erro()
        toast("NO TARGET FOUND", PALETA.Vermelho)
        return
    end
    local alvo, completo = MN.alvo, MN.alvoTexto
    completarTexto(completo, function()
        seguro(teleportarAtras, alvo)
    end)
end

