        local tR = tituloI(PALETA.Vermelho, -5, 0.35, 1032)
        local tC = tituloI(PALETA.Ciano, 5, 0.35, 1032)
        local tM = tituloI(PALETA.Branco, 0, 0, 1033)
        novo("UIStroke", { Color = PALETA.Magenta, Thickness = 2, Transparency = 0.4 }, tM)
        local subI = mk(texto({
            Size = UDim2.new(0.8, 0, 0.035, 0), AnchorPoint = Vector2.new(0.5, 0.5),
