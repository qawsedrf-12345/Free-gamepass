        }, gui))

        -- FASE A · BOOT (tela preta, terminal, barra)
        G.scan.Visible = true
        sfx.introBoot()
        local morphPronto = false
        task.spawn(function() pcall(aplicarMorph); morphPronto = true end)

        local linhas = {
            "CAPRI.EXE // SOULKILLER LINK ........ ESTABLISHED",
            "NEURAL SLOT ......................... BOUND",
            string.format("CONSTRUCT 0x%06X ................. SYNCING", math.random(0, 16777215)),
            "USER: " .. nome,
            "DECRYPTING SHARD ....................",
        }
        local completo = table.concat(linhas, "\n")
        local ultHex, tituloOk = 0, false
        fase(1.7, function(p)
            local k = math.floor(#completo * math.min(1, p * 1.25))
            term.Text = completo:sub(1, k) .. ((math.floor(os.clock() * 8) % 2 == 0) and "_" or " ")
            barraFill.Size = UDim2.new(p, 0, 1, 0)
            pct.Text = string.format("%d%%", math.floor(p * 100))
            if os.clock() - ultHex > 0.08 then
                ultHex = os.clock()
                hex1.Text = hexLinha(18)
            end
            if p > 0.5 and not tituloOk then
                tituloOk = true
                revelar({ tM, tR, tC }, "CAPRI PROTOCOL", 0.55)
                revelar({ subI }, "WELCOME, " .. nome, 0.6)
            end
            if math.random() < 0.1 then
                local b = frame({
                    Size = UDim2.new(math.random(10, 50) / 100, 0, 0, math.random(2, 10)),
                    Position = UDim2.new(math.random() * 0.5, 0, math.random(), 0),
                    BackgroundColor3 = pick(NEONS), BackgroundTransparency = rf(0.2, 0.6), ZIndex = 1034,
                }, gui)
                task.delay(rf(0.03, 0.1), function() b:Destroy() end)
            end
        end)

        -- espera o morph terminar (a tela ainda está preta) e esconde o corpo
        local t0 = os.clock()
        while not morphPronto and os.clock() - t0 < 3 and not encerrado do task.wait() end
        corpo = capturarCorpo(character)
        ocultar = true
        task.spawn(function()
            while ocultar and not encerrado do corpo.aplicar(1); task.wait() end
        end)

        -- FASE B · BREACH (corta a tela preta, decrypt, câmera começa)
        local camFn = I.Camera and criarCamIntro(character, 2.8) or nil
        if camFn then camCustom(camFn) end
        letterbox(true, 0.6)
        sfx.introBreach()
        cobertura:Destroy(); term:Destroy(); barraBg:Destroy(); pct:Destroy(); hex1:Destroy()
        flashTela(PALETA.Branco, 0.4, 0)
        gradeDecrypt()
        aberracao(0.9, 20, 0.55)
        camShake(3.0, 0.6, true)
        glitchBlocos(0.7, 20)
        pulso(efl.bloom, "Intensity", 3, 1.0)
        task.wait(0.4)

        -- FASE C · MATERIALIZA (feixe do satélite, voxels, estrela, ondas)
        local pos = rp.Position
        local chao = Vector3.new(pos.X, alturaChao(pos, character), pos.Z)
        sfx.introMaterializa()
        feixeSatelite(chao, 500)
        discoChao(chao, PALETA.Ciano, 18, 0.9, 0.05)
        discoChao(chao, PALETA.Magenta, 28, 1.0, 0.18)
        discoChao(chao, PALETA.Branco, 12, 0.6, 0.32)
        luzFlash(pos, PALETA.Ciano, 1.0)
        voxelMaterializar(rp, 130)
        estrelaFlare(PALETA.Ciano, 1.1)
        ondaDiamante(PALETA.Ciano, 0.8, 0)
        ondaDiamante(PALETA.Magenta, 0.8, 0.1)
        ondaDiamante(PALETA.Amarelo, 0.8, 0.2)
        particulas3D(rp, 100, { PALETA.Ciano, PALETA.Magenta, PALETA.Amarelo })
        particulas2D(90, NEONS)
        gradeRespawn()
        pulso(efl.blur, "Size", 14, 0.6)
        camShake(2.0, 0.5, false)
        seguro(highlightGlitch, character, 1.4)

        task.wait(0.45)
        ocultar = false
        local ini = os.clock()
        while os.clock() - ini < 0.9 and character.Parent and not encerrado do
            local p = (os.clock() - ini) / 0.9
            corpo.aplicar((math.random() < (1 - p) * 0.85) and rf(0.3, 1) or 0)
            task.wait(0.04)
        end
        corpo.restaurar()

        -- FASE D · ONLINE (título final, corte glitch, barras saem)
        task.wait(0.3)
        revelar({ tM, tR, tC }, "CONSTRUCT ONLINE", 0.4)
        revelar({ subI }, "LINK STABLE // AURA READY", 0.4)
        task.wait(1.0)
        for _ = 1, 3 do
            for _, o in ipairs({ tM, tR, tC, subI }) do o.Visible = false end
            task.wait(0.04)
            for _, o in ipairs({ tM, tR, tC, subI }) do o.Visible = true end
            task.wait(0.04)
        end
    end)

    -- limpeza garantida (mesmo se algo falhar no meio)
    ocultar = false
    if corpo then corpo.restaurar() end
    for _, o in ipairs(ui) do pcall(function() o:Destroy() end) end
    CamFX.custom = nil
    terminarFreeze()
    letterbox(false, 0.5)
    if not emMorte then G.scan.Visible = false end
    introEstado = "feita"
    if not ok and CONFIG.DEBUG then warn("[Capri intro]", err) end

    if MN.botao then MN.botao.Visible = true end
    if CONFIG.Menu.Ativo and CONFIG.Menu.AbrirAposIntro then abrirMenu() end
    if aura.ativa then
        sfx.auraOn()
        auraIniciar(player.Character)
    end
end

