local audiosAtivos = {}

-- fxs: { { "NomeDoSoundEffect", { Propriedade = valor } }, ... }
-- (bloqueante: chame via seguro/task.spawn)
local function tocarSom(ids, vol, vel, fxs)
    if not CONFIG.Audio.Ativo or encerrado then return nil end
    if type(ids) == "string" then ids = { ids } end
    for _, id in ipairs(ids) do
        if id ~= "" then
            local s = Instance.new("Sound")
            s.SoundId = id
            s.Volume = (vol or 1) * CONFIG.Audio.VolumeMestre
            s.PlaybackSpeed = vel or 1
            for _, e in ipairs(fxs or {}) do
                local ok, fx = pcall(Instance.new, e[1])
                if ok and fx then
                    for k, v in pairs(e[2]) do pcall(function() fx[k] = v end) end
                    fx.Parent = s
                end
            end
            s.Parent = SoundService
            local t0 = os.clock()
            while not s.IsLoaded and os.clock() - t0 < 0.4 do task.wait() end
            if s.IsLoaded then
                audiosAtivos[s] = true
                s.Ended:Connect(function() audiosAtivos[s] = nil; s:Destroy() end)
                task.delay(12, function() audiosAtivos[s] = nil; s:Destroy() end)
                s:Play()
                return s
            end
            s:Destroy()
        end
    end
    return nil
end

local function audioMorte()
    if not CONFIG.Audio.Ativo then return end
    -- impacto grave
    seguro(tocarSom, SONS.boom, 2.4, 0.5, {
        { "DistortionSoundEffect", { Level = 0.55 } },
        { "ReverbSoundEffect", { DecayTime = 3, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -4 } },
    })
    -- varredura digital descendo (power-down)
    for i = 1, 9 do
        task.delay((i - 1) * 0.065, function()
            seguro(tocarSom, SONS.ping, 0.8, 2.4 - (i - 1) * 0.25, {
                { "EchoSoundEffect", { Delay = 0.14, Feedback = 0.45, DryLevel = 0, WetLevel = -5 } },
            })
        end)
    end
    -- estalos de glitch
    for _ = 1, 7 do
        task.delay(rf(0.05, 0.7), function()
            seguro(tocarSom, SONS.click, rf(0.5, 1), rf(0.6, 3.2))
        end)
    end
    -- sub-grave pulsando
    seguro(tocarSom, SONS.bass, 1.6, 0.45, { { "TremoloSoundEffect", { Depth = 0.7, Frequency = 6, Duty = 0.5 } } })
    if CONFIG.Audio.CustomMorte ~= "" then
        seguro(tocarSom, CONFIG.Audio.CustomMorte, 1, rf(0.98, 1.02))
    end
end

local function audioRespawn()
    if not CONFIG.Audio.Ativo then return end
    -- arpejo de boot (construto ligando)
    local notas = { 0.7, 0.88, 1.05, 1.32, 1.65, 2.1 }
    for i, v in ipairs(notas) do
        task.delay((i - 1) * 0.06, function()
            seguro(tocarSom, SONS.ping, 0.85, v, {
                { "ChorusSoundEffect", { Depth = 0.6, Mix = 0.5, Rate = 1.2 } },
                { "ReverbSoundEffect", { DecayTime = 1.6, WetLevel = -5 } },
            })
        end)
    end
    -- impacto do feixe + trava de dados
    task.delay(0.30, function()
        seguro(tocarSom, SONS.boom, 1.6, 0.85, {
            { "DistortionSoundEffect", { Level = 0.35 } },
            { "ReverbSoundEffect", { DecayTime = 2.2, WetLevel = -3 } },
        })
    end)
    task.delay(0.36, function() seguro(tocarSom, SONS.snap, 1.2, 1.5) end)
    -- swell grave
    seguro(tocarSom, SONS.bass, 1.3, 0.6, { { "TremoloSoundEffect", { Depth = 0.8, Frequency = 9, Duty = 0.5 } } })
    if CONFIG.Audio.CustomRespawn ~= "" then
        seguro(tocarSom, CONFIG.Audio.CustomRespawn, 1, rf(0.98, 1.02))
    end
end

