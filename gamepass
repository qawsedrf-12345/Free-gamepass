local function listarPartes(character, semRaiz)
    local lista = {}
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BasePart") and (not semRaiz or d.Name ~= "HumanoidRootPart") and d.Transparency < 0.95 then
            lista[#lista + 1] = d
        end
    end
    return lista
end

-- corpo se desfaz em voxels neon
local function voxelDesintegrar(character)
    local partes = listarPartes(character, true)
    if #partes == 0 then return end

    task.spawn(function()
        local ini = os.clock()
        while os.clock() - ini < 0.9 and not encerrado do
            local a = (os.clock() - ini) / 0.9
            for _, p in ipairs(partes) do
                if p.Parent then
                    p.LocalTransparencyModifier = math.min(1, a * 1.3 + (math.random() < 0.2 and 0.25 or 0))
                end
            end
            task.wait(0.04)
        end
        for _, p in ipairs(partes) do
            if p.Parent then p.LocalTransparencyModifier = 1 end
        end
    end)

    for _ = 1, N(CONFIG.Morte.Voxels) do
        local base = pick(partes)
        local s = base.Size
        local off = Vector3.new(rf(-0.5, 0.5) * s.X, rf(-0.5, 0.5) * s.Y, rf(-0.5, 0.5) * s.Z)
        local pos = base.CFrame:PointToWorldSpace(off)
        local tam = rf(0.18, 0.5)
        local cubo = novaParte({ Size = Vector3.new(tam, tam, tam), CFrame = CFrame.new(pos),
                                 Color = pick(NEONS), Transparency = rf(0, 0.25) })
        local dir = Vector3.new(rf(-1, 1), rf(0.2, 1.4), rf(-1, 1))
        if dir.Magnitude < 0.01 then dir = Vector3.new(0, 1, 0) end
        local dest = pos + dir.Unit * rf(4, 13)
        local dur = rf(0.7, 1.5)
        tw(cubo, dur, {
            CFrame = CFrame.new(dest) * CFrame.Angles(rf(0, 6.28), rf(0, 6.28), rf(0, 6.28)),
            Size = Vector3.new(0.04, 0.04, 0.04), Transparency = 1,
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        task.delay(dur + 0.1, function() cubo:Destroy() end)
    end
end

-- voxels convergem e "montam" o personagem
local function voxelMaterializar(rp, qtd)
    local centro = rp.Position
    for _ = 1, N(qtd or CONFIG.Respawn.Voxels) do
        local dir = Vector3.new(rf(-1, 1), rf(-0.3, 1), rf(-1, 1))
        if dir.Magnitude < 0.01 then dir = Vector3.new(1, 0, 0) end
        local ini = centro + dir.Unit * rf(10, 18)
        local alvo = centro + Vector3.new(rf(-1.2, 1.2), rf(-2.5, 2.5), rf(-1.2, 1.2))
        local tam = rf(0.2, 0.55)
        local cubo = novaParte({ Size = Vector3.new(tam, tam, tam), CFrame = CFrame.new(ini),
                                 Color = pick(NEONS), Transparency = 0.1 })
        local dur = rf(0.35, 0.65)
        tw(cubo, dur, {
            CFrame = CFrame.new(alvo) * CFrame.Angles(rf(0, 6.28), rf(0, 6.28), rf(0, 6.28)),
            Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 0.8,
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(dur + 0.1, function() cubo:Destroy() end)
    end
end

local function highlightGlitch(character, dur)
    local h = novo("Highlight", {
        Adornee = character, FillColor = PALETA.Ciano, OutlineColor = PALETA.Branco,
        FillTransparency = 0.3, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, fxFolder)
    local cores = { PALETA.Ciano, PALETA.Magenta, PALETA.Amarelo, PALETA.Branco }
    local ini = os.clock()
    while os.clock() - ini < dur and character.Parent and not encerrado do
        local p = (os.clock() - ini) / dur
        h.FillColor = pick(cores)
        h.FillTransparency = 0.25 + 0.75 * p * p
        h.OutlineTransparency = p * p
        h.Enabled = math.random() > 0.15
        task.wait(0.045)
    end
    h:Destroy()
end

